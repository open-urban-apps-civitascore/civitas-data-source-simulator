# Copy to .env.local and fill in.

AUTH_TRUST_HOST=true
NEXTAUTH_SECRET=dev-only-simulator-nextauth-secret
KEYCLOAK_CLIENT_ID=demo-data-generator
KEYCLOAK_CLIENT_SECRET=dev-only-simulator-secret
KEYCLOAK_ISSUER=http://localhost:8080/realms/civitas-core

# In a cluster the browser and the server reach Keycloak at different addresses.
# The browser is redirected to KEYCLOAK_ISSUER; token, userinfo and key lookups
# use this one. Unset means both are the same, which is the local case.
#KEYCLOAK_INTERNAL_ISSUER=http://keycloak.civitas.svc.cluster.local:8080/realms/civitas-core

# Keycloak's default is RS256. A hardened realm may sign id_tokens with ES256,
# and a mismatch fails the sign-in callback with an unexpected algorithm.
#KEYCLOAK_ID_TOKEN_ALG=RS256

# The simulator's control API. Server-side only: the browser never calls it, so
# the address stays private and the token is attached in one place.
GENERATOR_BASE_URL=http://localhost:4300
#GENERATOR_BASE_URL=http://demo-data-generator.demo.svc.cluster.local:4300

# --- The CIVITAS/CORE portal backend ---
# Where the data structures of this instance are read from, INCLUDING the /v1
# context path. Read with the signed-in person's token. Unset means no portal to
# ask, and the data structures page shows bundled examples and says so.
#
# This is the GATEWAY, never the portal-backend directly — the same address the
# marketplace uses. The gateway sets the scope header the backend's authorizer
# needs; going straight to :8089 skips it and every read is refused with
# "Insufficient privileges".
PORTAL_BACKEND_BASE_URL=http://localhost:9080/v1
#PORTAL_BACKEND_BASE_URL=http://apisix-gateway.apisix.svc.cluster.local/v1

# Run the UI with no sign-in wall, for local work without a Keycloak. Never set
# this anywhere a municipality can reach. With it set there is no token, so the
# portal cannot be read either.
#SIMULATOR_SKIP_AUTH=1
