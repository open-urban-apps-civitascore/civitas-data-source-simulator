# Copy to .env.local and fill in.

# --- Auth (Keycloak via next-auth) ---
AUTH_SECRET="change-me"
AUTH_KEYCLOAK_ID="demo-data-generator"
AUTH_KEYCLOAK_SECRET="change-me"
AUTH_KEYCLOAK_ISSUER="http://localhost:8080/realms/civitas-core"
AUTH_URL="http://localhost:3003"

# --- The generator's control API ---
# Server-side only: the browser never talks to it directly, every call goes
# through this app's own /api routes so the address stays private and a token
# can be attached in one place once the control API checks authz.
GENERATOR_BASE_URL="http://localhost:4300"

# --- Sign-in wall ---
# Set to 1 to run the UI without Keycloak (local UI work only). Every page is
# then reachable unauthenticated and the header says so.
# SIMULATOR_SKIP_AUTH="1"
