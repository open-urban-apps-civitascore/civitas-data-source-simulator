# Copy to .env. The generator loads it on start; see src/config.ts.

# Where SQL simulations write their rows. The compose file in this repo ships
# this database; the platform polls the same tables as a data source.
# Inside the platform network the address is baumkataster-db:5432.
DEMO_DB_DSN="postgres://kataster:kataster@localhost:5544/fachverfahren"

# The broker as the generator reaches it from the host (published port 1884).
DEMO_BROKER_URL="mqtt://localhost:1884"

# --- Authentication ---
# The realm whose tokens the control API accepts. The service REFUSES TO START
# unless this or the opt-out below is set, so a deployment that forgets it fails
# loudly instead of quietly accepting every caller.
#AUTH_ISSUER_URL="http://localhost:8080/realms/civitas-core"
# Optional: a realm or client role a token must carry to change simulations.
#AUTH_REQUIRED_ROLE="simulator"
#AUTH_AUDIENCE=""

# Run without any check. Local development only: with this set, anyone who can
# reach the port may create, change and delete simulations.
SIMULATOR_AUTH_DISABLED="1"

# Port of the control API (default 4300).
# PORT="4300"

# dailyProfile peaks are written in local hours, so the zone has to be local.
# TZ="Europe/Berlin"
