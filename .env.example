# Copy to .env. The generator loads it on start; see src/config.ts.

# Where SQL simulations write their rows. The compose file in this repo ships
# this database; the platform polls the same tables as a data source.
# Inside the platform network the address is baumkataster-db:5432.
DEMO_DB_DSN="postgres://kataster:kataster@localhost:5544/fachverfahren"

# Port of the control API (default 4300).
# PORT="4300"

# dailyProfile peaks are written in local hours, so the zone has to be local.
# TZ="Europe/Berlin"
